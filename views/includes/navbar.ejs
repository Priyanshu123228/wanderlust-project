<style>
  .navbar {
    height: 5rem;
    background-color: white;
  }

  /* Search Form */
  .search-form {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 40px;
    padding: 0.3rem 0.4rem 0.3rem 1rem;
    background-color: white;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1);
  }

  /* Input */
  .search-inp {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    width: 18rem;
    font-size: 1rem;
  }

  .search-inp::placeholder {
    color: #717171;
  }

  /* Button */
  .search-btn {
    background-color: #fe424d;
    color: white;
    border: none;
    border-radius: 50px;
    padding: 0.5rem 1rem;
    font-weight: 500;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: white;
  }

  .search-btn i {
    margin-right: 0.4rem;
  }
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top">
  <div class="container-fluid">

    <!-- Logo -->
    <a class="navbar-brand" href="/">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- Toggle -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Left -->
      <div class="navbar-nav align-items-center gap-1">
        <a class="nav-link fw-semibold" href="/destinations">Destinations</a>
        <a class="nav-link fw-semibold" href="/listings">Stays</a>
        <a class="nav-link fw-semibold" href="/restaurants">Food</a>
        <a class="nav-link fw-semibold" href="/activities">Activities</a>
        <a class="nav-link fw-semibold" href="/attractions">Attractions</a>
        <a class="btn btn-sm btn-danger rounded-pill px-3 py-1 ms-1 text-white fw-bold shadow-sm" href="/itinerary/new" style="background-color: #fe424d; border: none;">
          <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Plan Trip
        </a>
      </div>

      <!-- Center Search -->
      <form class="d-flex mx-auto search-form" action="/destinations" method="GET" role="search">
        <input
          class="form-control search-inp"
          type="search"
          name="q"
          placeholder="Search destinations (e.g. Manali, Goa...)"
        />
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
          Search
        </button>
      </form>

      <!-- Right -->
      <div class="navbar-nav ms-auto align-items-center">
        <% if(currUser){ %>
          <a class="nav-link fw-semibold" href="/itinerary/my-trips"><i class="fa-regular fa-bookmark me-1 text-danger"></i>My Trips</a>
        <% } %>

        <a class="nav-link" href="/listings/new">Airbnb your home</a>

        <% if(!currUser){ %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>

        <% if(currUser){ %>
          <a class="nav-link" href="/logout">Logout</a>
        <% } %>
      </div>

    </div>
  </div>
</nav>  
<% layout("/layouts/boilerplate") %>

<div class="destination-hero py-4 mb-4 text-center rounded-4 shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #fe424d 100%); color: white; padding: 3rem 1.5rem;">
    <h1 class="fw-bold mb-2">Discover Iconic Destinations</h1>
    <p class="lead mb-4" style="max-width: 650px; margin: 0 auto; opacity: 0.95;">
        Explore top travel spots across India and beyond. Uncover scenic wonders, rich heritage, and authentic local experiences.
    </p>

    <!-- Search & Filter Bar -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <form action="/destinations" method="GET" class="d-flex bg-white rounded-pill p-1 shadow">
                <input 
                    type="text" 
                    name="q" 
                    value="<%= typeof q !== 'undefined' ? q : '' %>"
                    class="form-control border-0 rounded-pill px-3 shadow-none" 
                    placeholder="Search destination, state, or region..."
                >
                <button class="btn btn-danger rounded-pill px-4" type="submit">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Interest Pills Filter -->
<div class="d-flex flex-wrap gap-2 justify-content-center mb-4 pb-2">
    <% const interests = ["All", "Adventure", "Nature", "Beach", "Historical", "Culture", "Relaxation", "Food"]; %>
    <% for(let item of interests) { %>
        <a 
            href="/destinations?interest=<%= item %><%= typeof q !== 'undefined' && q ? '&q=' + q : '' %>" 
            class="btn btn-sm rounded-pill px-3 py-2 <%= (typeof selectedInterest !== 'undefined' && selectedInterest === item) ? 'btn-dark' : 'btn-outline-secondary' %>"
        >
            <%= item %>
        </a>
    <% } %>
    <% if(currUser) { %>
        <a href="/destinations/new" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-2 ms-auto">
            <i class="fa-solid fa-plus me-1"></i> Add Destination
        </a>
    <% } %>
</div>

<!-- Destinations Grid -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% if(allDestinations.length === 0) { %>
        <div class="col-12 text-center py-5">
            <i class="fa-solid fa-map-location-dot fa-3x text-muted mb-3"></i>
            <h4 class="text-secondary">No destinations found</h4>
            <p class="text-muted">Try a different search keyword or filter.</p>
            <a href="/destinations" class="btn btn-outline-danger rounded-pill mt-2">View All Destinations</a>
        </div>
    <% } %>

    <% for(let dest of allDestinations) { %>
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative destination-card">
                <img 
                    src="<%= dest.image.url %>" 
                    class="card-img-top" 
                    alt="<%= dest.name %>" 
                    style="height: 220px; object-fit: cover;"
                >
                
                <% if(dest.featured) { %>
                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                        <i class="fa-solid fa-star me-1"></i> Featured
                    </span>
                <% } %>

                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="card-title fw-bold mb-0 text-dark"><%= dest.name %></h4>
                        <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= dest.location %></small>
                    </div>

                    <p class="card-text text-muted mb-3 small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        <%= dest.description %>
                    </p>

                    <!-- Popular Tags -->
                    <div class="mb-3">
                        <% if(dest.popularInterests && dest.popularInterests.length) { %>
                            <% for(let tag of dest.popularInterests.slice(0, 3)) { %>
                                <span class="badge bg-light text-secondary border me-1 mb-1"><%= tag %></span>
                            <% } %>
                        <% } %>
                    </div>

                    <!-- Budget Summary Indicator -->
                    <div class="bg-light p-2 rounded-3 small mb-3 text-muted">
                        <i class="fa-solid fa-wallet text-success me-1"></i>
                        Avg: <strong>&#8377;<%= (dest.estimatedBudget && dest.estimatedBudget.medium) ? dest.estimatedBudget.medium.toLocaleString("en-IN") : '3,000' %></strong> / day
                        <span class="float-end"><i class="fa-regular fa-sun text-warning me-1"></i><%= dest.bestTimeToVisit || 'All Year' %></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-auto d-flex gap-2">
                        <a href="/destinations/<%= dest._id %>" class="btn btn-outline-dark flex-grow-1 rounded-pill">
                            Explore
                        </a>
                        <a href="/itinerary/new?destination=<%= dest.name %>" class="btn btn-danger flex-grow-1 rounded-pill" style="background-color: #fe424d; border-color: #fe424d;">
                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Plan Trip
                        </a>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

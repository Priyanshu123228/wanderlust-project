<% layout("/layouts/boilerplate") %>

<div class="row my-4">
    <!-- Main Left Column -->
    <div class="col-lg-8">
        <!-- Destination Banner -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="position-relative">
                <img 
                    src="<%= destination.image.url %>" 
                    class="w-100" 
                    alt="<%= destination.name %>"
                    style="height: 380px; object-fit: cover;"
                >
                <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%); color: white;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-location-dot me-1"></i><%= destination.location %>, <%= destination.country %></span>
                        <% if(destination.featured) { %>
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-star me-1"></i>Top Rated</span>
                        <% } %>
                    </div>
                    <h1 class="display-5 fw-bold mb-1"><%= destination.name %></h1>
                    <p class="lead mb-0 text-white-50"><%= destination.tagline %></p>
                </div>
            </div>

            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">About <%= destination.name %></h4>
                <p class="text-secondary leading-relaxed" style="line-height: 1.8; font-size: 1.05rem;">
                    <%= destination.description %>
                </p>

                <!-- Interests -->
                <% if(destination.popularInterests && destination.popularInterests.length) { %>
                    <div class="my-4">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2">Ideal For</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <% for(let interest of destination.popularInterests) { %>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                    <i class="fa-solid fa-hashtag text-danger me-1"></i><%= interest %>
                                </span>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <!-- Quick Stats Grid -->
                <div class="row g-3 my-2">
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <small class="text-muted d-block mb-1"><i class="fa-regular fa-calendar text-danger me-1"></i> Best Time to Visit</small>
                            <span class="fw-bold"><%= destination.bestTimeToVisit || 'October to May' %></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <small class="text-muted d-block mb-1"><i class="fa-solid fa-cloud-sun text-warning me-1"></i> Climate</small>
                            <span class="fw-bold"><%= destination.climate || 'Pleasant & Mountainous' %></span>
                        </div>
                    </div>
                </div>

                <!-- Budget Breakdown Box -->
                <div class="card border-0 bg-light rounded-4 p-4 my-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-wallet text-success me-2"></i>Estimated Daily Budget (Per Person)</h5>
                    <div class="row text-center g-3">
                        <div class="col-4">
                            <div class="bg-white p-3 rounded-3 shadow-sm border">
                                <span class="badge bg-secondary mb-2">Low / Backpacker</span>
                                <h5 class="fw-bold text-success mb-0">&#8377;<%= destination.estimatedBudget?.low?.toLocaleString("en-IN") || '1,500' %></h5>
                                <small class="text-muted">Hostels & local food</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white p-3 rounded-3 shadow-sm border border-primary">
                                <span class="badge bg-primary mb-2">Medium / Standard</span>
                                <h5 class="fw-bold text-primary mb-0">&#8377;<%= destination.estimatedBudget?.medium?.toLocaleString("en-IN") || '3,500' %></h5>
                                <small class="text-muted">Hotels & sightseeing</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white p-3 rounded-3 shadow-sm border">
                                <span class="badge bg-dark mb-2">High / Luxury</span>
                                <h5 class="fw-bold text-dark mb-0">&#8377;<%= destination.estimatedBudget?.high?.toLocaleString("en-IN") || '7,500' %></h5>
                                <small class="text-muted">Resorts & fine dining</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interactive Location Map -->
                <div class="my-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-map-pin text-danger me-2"></i>Location & Map</h5>
                    <div id="dest-map" class="rounded-4 border shadow-sm" style="height: 320px; width: 100%;"></div>
                </div>

                <% if(currUser) { %>
                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <a href="/destinations/<%= destination._id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            <i class="fa-solid fa-pen me-1"></i> Edit Destination
                        </a>
                        <form action="/destinations/<%= destination._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this destination?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Featured Stays in this Destination -->
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Popular Stays in <%= destination.name %></h4>
                <a href="/listings?destination=<%= destination.name %>" class="btn btn-sm btn-outline-danger rounded-pill">View All Stays</a>
            </div>

            <% if(stays && stays.length > 0) { %>
                <div class="row row-cols-md-2 row-cols-1 g-3">
                    <% for(let stay of stays) { %>
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                <img src="<%= stay.image.url %>" class="card-img-top" style="height: 160px; object-fit: cover;" alt="<%= stay.title %>">
                                <div class="card-body p-3">
                                    <h6 class="card-title fw-bold text-truncate mb-1"><%= stay.title %></h6>
                                    <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= stay.location %></p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-dark">&#8377;<%= stay.price.toLocaleString("en-IN") %> <small class="text-muted fw-normal">/ night</small></span>
                                        <a href="/listings/<%= stay._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">View</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="p-4 bg-light rounded-3 text-center text-muted">
                    <p class="mb-2">No specific stays currently mapped directly. Explore all stays or add a new listing.</p>
                    <a href="/listings" class="btn btn-sm btn-dark rounded-pill">Explore All Stays</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Right Sticky Action Column -->
    <div class="col-lg-4">
        <div class="card border-0 shadow rounded-4 p-4 sticky-top" style="top: 6rem;">
            <div class="text-center mb-3">
                <div class="d-inline-flex p-3 bg-danger bg-opacity-10 text-danger rounded-circle mb-2">
                    <i class="fa-solid fa-wand-magic-sparkles fa-2x"></i>
                </div>
                <h4 class="fw-bold mb-1">Smart Trip Planner</h4>
                <p class="text-muted small">Generate a personalized, day-by-day travel plan for <%= destination.name %> in seconds.</p>
            </div>

            <hr class="my-3">

            <div class="d-flex flex-column gap-2 mb-4">
                <div class="d-flex align-items-center gap-2 text-secondary small">
                    <i class="fa-solid fa-check text-success"></i> Handpicked attractions & activities
                </div>
                <div class="d-flex align-items-center gap-2 text-secondary small">
                    <i class="fa-solid fa-check text-success"></i> Best-rated restaurants & dining stops
                </div>
                <div class="d-flex align-items-center gap-2 text-secondary small">
                    <i class="fa-solid fa-check text-success"></i> Accurate budget breakdown & accommodation
                </div>
                <div class="d-flex align-items-center gap-2 text-secondary small">
                    <i class="fa-solid fa-check text-success"></i> Route-optimized time slots
                </div>
            </div>

            <a 
                href="/itinerary/new?destination=<%= destination.name %>" 
                class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm w-100 py-3"
                style="background-color: #fe424d; border-color: #fe424d;"
            >
                <i class="fa-solid fa-compass me-2"></i> Plan <%= destination.name %> Trip
            </a>

            <div class="mt-3 text-center">
                <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i> Instant AI & algorithmic generation</small>
            </div>
        </div>
    </div>
</div>

<script>
    const coordinates = <%- JSON.stringify(destination.geometry?.coordinates || [77.1892, 32.2432]) %>;
    const mapToken = "<%= mapToken || '' %>";

    if (mapToken && document.getElementById("dest-map")) {
        mapboxgl.accessToken = mapToken;
        const map = new mapboxgl.Map({
            container: "dest-map",
            style: "mapbox://styles/mapbox/streets-v12",
            center: coordinates,
            zoom: 10
        });

        new mapboxgl.Marker({ color: "#fe424d" })
            .setLngLat(coordinates)
            .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(`<h6><%= destination.name %></h6><p><%= destination.location %></p>`))
            .addTo(map);

        map.addControl(new mapboxgl.NavigationControl());
    }
</script>

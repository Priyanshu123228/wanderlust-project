<% layout("/layouts/boilerplate") %>

<style>
    .timeline-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: #fe424d;
        border: 3px solid white;
        box-shadow: 0 0 0 2px #fe424d;
    }
    .timeline-card {
        border-left: 2px dashed #ddd;
        position: relative;
        padding-left: 1.5rem;
    }
    .cost-card {
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
    }
    .slot-badge-morning { background-color: #fff3cd; color: #856404; }
    .slot-badge-lunch { background-color: #ffeeba; color: #856404; }
    .slot-badge-afternoon { background-color: #d1ecf1; color: #0c5460; }
    .slot-badge-evening { background-color: #f8d7da; color: #721c24; }
    .slot-badge-dinner { background-color: #e2e3e5; color: #383d41; }
    .slot-badge-stay { background-color: #d4edda; color: #155724; }

    .trip-hero-badge {
        background-color: rgba(255, 255, 255, 0.22) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        font-weight: 600 !important;
        font-size: 0.85rem !important;
        padding: 0.4rem 0.85rem !important;
        border-radius: 9999px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.35rem !important;
        backdrop-filter: blur(6px);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .trip-hero-badge i {
        color: #fef08a !important;
    }
</style>

<div class="row mt-4 mb-5">
    <!-- Left Column: Itinerary Details -->
    <div class="col-lg-8 col-12">
        <!-- Trip Banner -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #fe424d 100%); color: white;">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <% if(typeof isSharedView !== 'undefined' && isSharedView) { %>
                        <span class="badge bg-info text-dark rounded-pill px-3 py-2 mb-2"><i class="fa-solid fa-share-nodes me-1"></i>Shared Trip &bull; Read-Only View</span>
                    <% } else { %>
                        <span class="badge bg-success rounded-pill px-3 py-2 mb-2"><i class="fa-solid fa-circle-check me-1"></i><%= itinerary.status || 'Saved Itinerary' %></span>
                    <% } %>
                    <h2 class="fw-bold mb-1 text-white"><%= itinerary.title %></h2>
                    <p class="mb-2 opacity-90"><i class="fa-solid fa-location-dot me-1 text-warning"></i><%= itinerary.destinationName %></p>
                </div>
                <div class="text-end">
                    <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-bold"><%= itinerary.budgetTier %> Budget</span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-2 pt-2 border-top border-light border-opacity-25">
                <span class="trip-hero-badge"><i class="fa-regular fa-calendar"></i> <%= itinerary.durationDays %> Days</span>
                <span class="trip-hero-badge"><i class="fa-solid fa-users"></i> <%= itinerary.numTravelers %> Travelers</span>
                <% if(typeof weather !== 'undefined' && weather && weather.available && weather.current) { %>
                    <span class="trip-hero-badge"><i class="fa-solid fa-cloud-sun"></i> <%= weather.current.emoji %> <%= weather.current.temperature %>&deg;C &bull; <%= weather.current.condition %></span>
                <% } %>
                <% if(itinerary.interests && itinerary.interests.length) { %>
                    <% for(let interest of itinerary.interests) { %>
                        <span class="trip-hero-badge"><i class="fa-solid fa-hashtag"></i> <%= interest %></span>
                    <% } %>
                <% } %>
            </div>
        </div>

        <!-- Custom Notes if present -->
        <% if(itinerary.customNotes) { %>
            <div class="card border-0 bg-warning bg-opacity-10 border-start border-4 border-warning rounded-3 p-3 mb-4">
                <h6 class="fw-bold mb-1 text-dark"><i class="fa-regular fa-note-sticky text-warning me-2"></i>Trip Notes</h6>
                <p class="text-secondary small mb-0"><%= itinerary.customNotes %></p>
            </div>
        <% } %>

        <!-- Navigation Tabs -->
        <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="tripTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 fw-semibold" id="itinerary-tab" data-bs-toggle="tab" data-bs-target="#itinerary-pane" type="button" role="tab">
                    <i class="fa-solid fa-route me-1"></i> Day-by-Day Plan
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-semibold text-secondary" id="map-tab" data-bs-toggle="tab" data-bs-target="#map-pane" type="button" role="tab">
                    <i class="fa-solid fa-map-location-dot me-1 text-danger"></i> Route Map
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-semibold text-secondary" id="weather-tab" data-bs-toggle="tab" data-bs-target="#weather-pane" type="button" role="tab">
                    <i class="fa-solid fa-cloud-sun me-1 text-warning"></i> Weather
                </button>
            </li>
        </ul>

        <!-- Tab Content Panes -->
        <div class="tab-content" id="tripTabContent">
            
            <!-- 1. Day-by-Day Itinerary Tab -->
            <div class="tab-pane fade show active" id="itinerary-pane" role="tabpanel">
                <% for(let day of itinerary.dailyPlan) { %>
                    <% 
                        let dWeather = (day.weather && day.weather.available) ? day.weather : ((typeof weather !== 'undefined' && weather && weather.available && weather.dailyForecast && weather.dailyForecast[day.dayNumber - 1]) ? weather.dailyForecast[day.dayNumber - 1] : null);
                    %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-dark text-white p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0"><i class="fa-regular fa-calendar-check text-warning me-1"></i>Day <%= day.dayNumber %></h5>
                                <small class="text-light opacity-75 d-none d-md-inline">&bull; <%= day.morning?.title || 'Exploration' %></small>
                            </div>
                            <% if(dWeather && (dWeather.available || dWeather.temperature !== undefined)) { %>
                                <span class="badge bg-light text-dark px-3 py-1 rounded-pill small fw-semibold">
                                    <%= dWeather.emoji || '🌤️' %> <%= dWeather.temperature %>&deg;C &bull; <%= dWeather.condition %>
                                </span>
                            <% } else { %>
                                <span class="badge bg-secondary bg-opacity-50 text-light px-2 py-1 rounded-pill small" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-cloud me-1"></i>Weather unavailable
                                </span>
                            <% } %>
                        </div>

                        <div class="card-body p-4">
                            <!-- Weather Advisory Note for the Day -->
                            <% if(dWeather && (dWeather.available || dWeather.temperature !== undefined)) { %>
                                <div class="p-3 mb-4 rounded-3 border-0 bg-light d-flex align-items-start gap-3">
                                    <span class="fs-4"><%= dWeather.emoji || '🌤️' %></span>
                                    <div class="w-100">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                            <strong class="text-dark"><%= dWeather.condition %> (<%= dWeather.tempMin %>&deg;C - <%= dWeather.tempMax %>&deg;C)</strong>
                                            <% if(dWeather.rainProbability > 0) { %>
                                                <span class="badge bg-info-subtle text-info-emphasis rounded-pill small"><i class="fa-solid fa-umbrella me-1"></i><%= dWeather.rainProbability %>% rain chance</span>
                                            <% } %>
                                        </div>
                                        <p class="text-secondary small mb-0 mt-1">
                                            <%= dWeather.suggestion || 'Weather conditions are suitable for planned activities.' %>
                                        </p>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Morning Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1"></div>
                                <span class="badge slot-badge-morning px-2 py-1 rounded-pill small fw-bold">MORNING &bull; <%= day.morning?.time || '09:00 AM - 12:30 PM' %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.morning?.title || 'Morning Exploration' %></h6>
                                <p class="text-secondary small mb-1"><%= day.morning?.description || '' %></p>
                                <div class="small text-muted d-flex justify-content-between align-items-center flex-wrap">
                                    <span>
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.morning?.location || itinerary.destinationName %>
                                        <% if(day.morning?.estimatedCost > 0) { %>
                                            &bull; <span class="fw-semibold text-dark">&#8377;<%= day.morning.estimatedCost.toLocaleString("en-IN") %> entry</span>
                                        <% } else { %>
                                            &bull; <span class="badge bg-success-subtle text-success">Free Entry</span>
                                        <% } %>
                                    </span>
                                </div>
                            </div>

                            <!-- Lunch Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #f39c12; box-shadow: 0 0 0 2px #f39c12;"></div>
                                <span class="badge slot-badge-lunch px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-utensils me-1"></i>LUNCH &bull; <%= day.lunch?.time || '01:00 PM - 02:30 PM' %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.lunch?.title || 'Lunch Dining' %></h6>
                                <p class="text-secondary small mb-1">Cuisine: <strong><%= day.lunch?.cuisine || 'Regional' %></strong> &bull; Avg. &#8377;<%= (day.lunch?.estimatedCost || 400).toLocaleString("en-IN") %>/person</p>
                                <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.lunch?.location || itinerary.destinationName %></small>
                            </div>

                            <!-- Afternoon Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #8e44ad; box-shadow: 0 0 0 2px #8e44ad;"></div>
                                <span class="badge slot-badge-afternoon px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-person-hiking me-1"></i>AFTERNOON &bull; <%= day.afternoon?.time || '03:00 PM - 05:30 PM' %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.afternoon?.title || 'Afternoon Experience' %></h6>
                                <p class="text-secondary small mb-1"><%= day.afternoon?.description || '' %></p>
                                <div class="small text-muted d-flex justify-content-between align-items-center flex-wrap">
                                    <span>
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.afternoon?.location || itinerary.destinationName %>
                                        &bull; <span class="fw-semibold text-dark">&#8377;<%= (day.afternoon?.estimatedCost || 0).toLocaleString("en-IN") %> /person</span>
                                    </span>
                                </div>
                            </div>

                            <!-- Evening Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #e74c3c; box-shadow: 0 0 0 2px #e74c3c;"></div>
                                <span class="badge slot-badge-evening px-2 py-1 rounded-pill small fw-bold"><i class="fa-regular fa-moon me-1"></i>EVENING &bull; <%= day.evening?.time || '06:00 PM - 08:00 PM' %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.evening?.title || 'Evening Promenade' %></h6>
                                <p class="text-secondary small mb-1"><%= day.evening?.description || '' %></p>
                                <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.evening?.location || itinerary.destinationName %></small>
                            </div>

                            <!-- Dinner Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #34495e; box-shadow: 0 0 0 2px #34495e;"></div>
                                <span class="badge slot-badge-dinner px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-wine-glass me-1"></i>DINNER &bull; <%= day.dinner?.time || '08:30 PM - 10:00 PM' %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.dinner?.title || 'Dinner Dining' %></h6>
                                <p class="text-secondary small mb-1">Cuisine: <strong><%= day.dinner?.cuisine || 'Regional Flavors' %></strong> &bull; Avg. &#8377;<%= (day.dinner?.estimatedCost || 500).toLocaleString("en-IN") %>/person</p>
                                <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.dinner?.location || itinerary.destinationName %></small>
                            </div>

                            <!-- Night Stay Slot -->
                            <div class="timeline-card">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #27ae60; box-shadow: 0 0 0 2px #27ae60;"></div>
                                <span class="badge slot-badge-stay px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-bed me-1"></i>NIGHT STAY</span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.nightStay?.title || 'Recommended Accommodation' %></h6>
                                <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.nightStay?.location || itinerary.destinationName %> &bull; &#8377;<%= (day.nightStay?.pricePerNight || 3500).toLocaleString("en-IN") %> /night</p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- 2. Route Map Tab -->
            <div class="tab-pane fade" id="map-pane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Trip Route Map & Points of Interest</h5>
                    <div id="itinerary-map" class="rounded-4 border" style="height: 420px; width: 100%;"></div>
                </div>
            </div>

            <!-- 3. Weather Forecast Tab -->
            <div class="tab-pane fade" id="weather-pane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-cloud-sun text-warning me-2"></i>Destination Weather Forecast</h5>
                    <% if(typeof weather !== 'undefined' && weather && weather.available && weather.dailyForecast && weather.dailyForecast.length) { %>
                        <div class="row row-cols-md-3 row-cols-1 g-3">
                            <% for(let df of weather.dailyForecast) { %>
                                <div class="col">
                                    <div class="bg-light p-3 rounded-4 border text-center h-100">
                                        <h6 class="fw-bold text-dark mb-1"><%= df.dayName || ('Day ' + df.dayNumber) %></h6>
                                        <div class="fs-1 my-2"><%= df.emoji || '🌤️' %></div>
                                        <h4 class="fw-bold mb-0 text-dark"><%= df.temperature %>&deg;C</h4>
                                        <small class="text-secondary d-block"><%= df.condition %></small>
                                        <small class="text-muted d-block mt-1">Range: <%= df.tempMin %>&deg;C - <%= df.tempMax %>&deg;C</small>
                                        <% if(df.rainProbability > 0) { %>
                                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill small mt-2">
                                                <i class="fa-solid fa-umbrella me-1"></i><%= df.rainProbability %>% rain
                                            </span>
                                        <% } %>
                                        <% if(df.suggestion) { %>
                                            <p class="small text-muted mt-2 mb-0" style="font-size: 0.8rem;"><%= df.suggestion %></p>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="p-4 bg-light rounded-4 text-center text-muted">
                            <i class="fa-solid fa-cloud fa-3x mb-2 text-secondary"></i>
                            <h6>Weather information is currently unavailable.</h6>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Action Footer -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top mb-5">
            <% if(currUser && itinerary.user && currUser._id.equals(itinerary.user._id) && !(typeof isSharedView !== 'undefined' && isSharedView)) { %>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/itinerary/<%= itinerary._id %>/edit" class="btn btn-outline-dark rounded-pill px-4">
                        <i class="fa-solid fa-pen me-1"></i> Edit Trip
                    </a>
                    <form action="/itinerary/<%= itinerary._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this saved trip?');" class="d-inline">
                        <button class="btn btn-outline-danger rounded-pill px-4">
                            <i class="fa-solid fa-trash me-1"></i> Delete Trip
                        </button>
                    </form>
                </div>
            <% } %>

            <div class="d-flex flex-wrap gap-2 ms-auto">
                <button type="button" class="btn btn-outline-dark rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#shareTripModal">
                    <i class="fa-solid fa-share-nodes me-1"></i> Share Trip
                </button>
                <a href="/itinerary/<%= itinerary._id %>/download" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" style="background-color: #fe424d; border-color: #fe424d;">
                    <i class="fa-solid fa-file-arrow-down me-1"></i> Download Trip
                </a>
                <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fa-solid fa-print me-1"></i> Print
                </button>
            </div>
        </div>
    </div>

    <!-- Right Column: Budget Breakdown & Quick Links -->
    <div class="col-lg-4 col-12">
        <div class="sticky-top" style="top: 6rem;">
            <div class="card cost-card border-0 shadow-lg p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold"><i class="fa-solid fa-calculator me-1"></i>Budget Summary</span>
                    <small class="opacity-75"><%= itinerary.numTravelers %> travelers &bull; <%= itinerary.durationDays %> days</small>
                </div>

                <div class="text-center my-3 pb-3 border-bottom border-light border-opacity-25">
                    <small class="text-uppercase tracking-wider opacity-75">Estimated Total Trip Cost</small>
                    <h1 class="display-5 fw-bold mb-0 text-white">&#8377;<%= itinerary.costBreakdown.grandTotal.toLocaleString("en-IN") %></h1>
                    <small class="opacity-75">(&#8377;<%= Math.round(itinerary.costBreakdown.grandTotal / itinerary.numTravelers).toLocaleString("en-IN") %> per person)</small>
                </div>

                <!-- Detailed Breakdown Items -->
                <div class="d-flex flex-column gap-2 text-white small mb-3">
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-bed text-warning me-2"></i>Accommodation (<%= itinerary.durationDays > 1 ? itinerary.durationDays - 1 : 1 %> nights)</span>
                        <strong class="fs-6">&#8377;<%= itinerary.costBreakdown.stayTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-utensils text-info me-2"></i>Meals & Dining</span>
                        <strong class="fs-6">&#8377;<%= itinerary.costBreakdown.foodTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-person-hiking text-success me-2"></i>Activities & Sports</span>
                        <strong class="fs-6">&#8377;<%= itinerary.costBreakdown.activitiesTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-ticket text-danger me-2"></i>Attraction Entry Fees</span>
                        <strong class="fs-6">&#8377;<%= itinerary.costBreakdown.entryFeesTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-taxi text-light me-2"></i>Estimated Local Transit</span>
                        <strong class="fs-6">&#8377;<%= itinerary.costBreakdown.estimatedTransportation.toLocaleString("en-IN") %></strong>
                    </div>
                </div>
            </div>

            <!-- Quick Action Links -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h6 class="fw-bold mb-3">Trip Actions</h6>
                <div class="d-flex flex-column gap-2">
                    <a href="/itinerary/<%= itinerary._id %>/download" class="btn btn-danger rounded-pill w-100 fw-bold shadow-sm" style="background-color: #fe424d; border-color: #fe424d;">
                        <i class="fa-solid fa-file-arrow-down me-2"></i> Download Trip (PDF)
                    </a>
                    <button type="button" class="btn btn-outline-dark rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#shareTripModal">
                        <i class="fa-solid fa-share-nodes me-2"></i> Share Trip
                    </button>
                    <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill w-100">
                        <i class="fa-solid fa-print me-2"></i> Print Itinerary
                    </button>
                    <hr class="my-2 text-muted">
                    <a href="/itinerary/my-trips" class="btn btn-outline-dark rounded-pill w-100">
                        <i class="fa-regular fa-bookmark me-1"></i> Back to My Trips
                    </a>
                    <a href="/itinerary/new" class="btn btn-light border rounded-pill w-100">
                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Plan Another Trip
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Share Trip Modal -->
<div class="modal fade" id="shareTripModal" tabindex="-1" aria-labelledby="shareTripModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="shareTripModalLabel">
                    <i class="fa-solid fa-share-nodes text-danger me-2"></i>Share Your Itinerary
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-secondary small mb-3">Anyone with this link can view this complete travel plan, day-by-day itinerary, route map, and budget breakdown in read-only mode.</p>
                <div class="input-group">
                    <input type="text" id="shareLinkInput" class="form-control rounded-start-pill px-3" readonly value="">
                    <button class="btn btn-danger rounded-end-pill px-4 fw-bold" type="button" id="copyShareBtn" onclick="copyShareUrl()" style="background-color: #fe424d; border-color: #fe424d;">
                        <i class="fa-regular fa-copy me-1"></i> Copy
                    </button>
                </div>
                <div id="copySuccessAlert" class="small text-success fw-semibold mt-2 d-none">
                    <i class="fa-solid fa-check me-1"></i> Link copied to clipboard!
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const mapToken = "<%= mapToken || '' %>";
    const dailyPlan = <%- JSON.stringify(itinerary.dailyPlan) %>;

    // Set Share URL
    const shareUrl = `${window.location.origin}/itinerary/<%= itinerary._id %>/share`;
    const shareInput = document.getElementById("shareLinkInput");
    if (shareInput) shareInput.value = shareUrl;

    function copyShareUrl() {

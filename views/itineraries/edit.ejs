<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
    <div class="col-lg-8 offset-lg-2 col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <h2 class="fw-bold mb-1">Edit Trip Details</h2>
            <p class="text-muted mb-4">Update custom notes and status for your trip to <%= itinerary.destinationName %>.</p>

            <form method="POST" action="/itinerary/<%= itinerary._id %>?_method=PUT" class="needs-validation" novalidate>
                <div class="row g-3">
                    <div class="col-12">
                        <label for="title" class="form-label fw-semibold">Trip Title</label>
                        <input name="title" id="title" value="<%= itinerary.title %>" type="text" class="form-control rounded-3" required>
                    </div>

                    <div class="col-md-6">
                        <label for="status" class="form-label fw-semibold">Trip Status</label>
                        <% const statuses = ["Draft", "Planned", "Completed"]; %>
                        <select name="status" id="status" class="form-select rounded-3">
                            <% for(let st of statuses) { %>
                                <option value="<%= st %>" <%= (itinerary.status === st) ? 'selected' : '' %>><%= st %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Destination</label>
                        <input type="text" value="<%= itinerary.destinationName %>" class="form-control rounded-3 bg-light" disabled>
                    </div>

                    <div class="col-12">
                        <label for="customNotes" class="form-label fw-semibold">Personal Notes & Checklist</label>
                        <textarea name="customNotes" id="customNotes" rows="4" class="form-control rounded-3" placeholder="Add packing list, flight/train details, emergency contacts..."><%= itinerary.customNotes || '' %></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-2 d-flex gap-2">
                    <button class="btn btn-danger rounded-pill px-4 py-2" style="background-color: #fe424d; border-color: #fe424d;">
                        <i class="fa-solid fa-check me-1"></i> Update Trip
                    </button>
                    <a href="/itinerary/<%= itinerary._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<% layout("/layouts/boilerplate") %>

<style>
    .timeline-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: #fe424d;
        border: 3px solid white;
        box-shadow: 0 0 0 2px #fe424d;
    }
    .timeline-card {
        border-left: 2px dashed #ddd;
        position: relative;
        padding-left: 1.5rem;
    }
    .cost-card {
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
    }
    .slot-badge-travel { background-color: #e0f2fe; color: #0369a1; }
    .slot-badge-morning { background-color: #fff3cd; color: #856404; }
    .slot-badge-lunch { background-color: #ffeeba; color: #856404; }
    .slot-badge-afternoon { background-color: #d1ecf1; color: #0c5460; }
    .slot-badge-evening { background-color: #f8d7da; color: #721c24; }
    .slot-badge-dinner { background-color: #e2e3e5; color: #383d41; }
    .slot-badge-stay { background-color: #d4edda; color: #155724; }

    .trip-hero-badge {
        background-color: rgba(255, 255, 255, 0.22) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        font-weight: 600 !important;
        font-size: 0.85rem !important;
        padding: 0.4rem 0.85rem !important;
        border-radius: 9999px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.35rem !important;
        backdrop-filter: blur(6px);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .trip-hero-badge i {
        color: #fef08a !important;
    }

    .route-header-pill {
        background: rgba(254, 66, 77, 0.15);
        border: 1px solid rgba(254, 66, 77, 0.3);
        color: #fe424d;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
</style>

<div class="row mt-4 mb-5">
    <!-- Left Column: Day-by-Day Itinerary Plan -->
    <div class="col-lg-8 col-12">
        <!-- Trip Header Banner -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%); color: white;">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="badge bg-danger rounded-pill px-3 py-2 mb-2"><i class="fa-solid fa-sparkles me-1"></i>Generated Smart Itinerary</span>
                    <h2 class="fw-bold mb-1 text-white"><%= plan.title %></h2>
                    <p class="mb-2 opacity-90 fs-6">
                        <i class="fa-solid fa-location-arrow text-warning me-1"></i> <strong><%= plan.fromLocation?.name || 'Starting Point' %></strong> 
                        <i class="fa-solid fa-arrow-right-long mx-2 text-light"></i> 
                        <i class="fa-solid fa-location-dot text-danger me-1"></i> <strong><%= plan.destinationName %></strong>
                    </p>
                </div>
                <div class="text-end">
                    <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-bold"><%= plan.budgetTier %> Budget</span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-2 pt-2 border-top border-light border-opacity-25">
                <span class="trip-hero-badge"><i class="fa-solid fa-car-side"></i> <%= plan.transportMode || 'Car' %></span>
                <% if(plan.travelDistanceKm) { %>
                    <span class="trip-hero-badge"><i class="fa-solid fa-road"></i> <%= plan.travelDistanceKm %> km</span>
                <% } %>
                <% if(plan.travelDurationText) { %>
                    <span class="trip-hero-badge"><i class="fa-regular fa-clock"></i> <%= plan.travelDurationText %> travel</span>
                <% } %>
                <span class="trip-hero-badge"><i class="fa-regular fa-calendar"></i> <%= plan.durationDays %> Days</span>
                <span class="trip-hero-badge"><i class="fa-solid fa-users"></i> <%= plan.numTravelers %> Travelers</span>
                <% if(plan.weather && plan.weather.available && plan.weather.current) { %>
                    <span class="trip-hero-badge"><i class="fa-solid fa-cloud-sun"></i> <%= plan.weather.current.emoji %> <%= plan.weather.current.temperature %>&deg;C &bull; <%= plan.weather.current.condition %></span>
                <% } %>
                <% for(let interest of (plan.interests || [])) { %>
                    <span class="trip-hero-badge"><i class="fa-solid fa-hashtag"></i> <%= interest %></span>
                <% } %>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="previewTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 fw-semibold" id="itinerary-tab" data-bs-toggle="tab" data-bs-target="#itinerary-pane" type="button" role="tab">
                    <i class="fa-solid fa-route me-1"></i> Day-by-Day Plan
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-semibold text-secondary" id="map-tab" data-bs-toggle="tab" data-bs-target="#map-pane" type="button" role="tab">
                    <i class="fa-solid fa-map-location-dot me-1 text-danger"></i> Route Map & Directions
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 fw-semibold text-secondary" id="weather-tab" data-bs-toggle="tab" data-bs-target="#weather-pane" type="button" role="tab">
                    <i class="fa-solid fa-cloud-sun me-1 text-warning"></i> Destination Weather
                </button>
            </li>
        </ul>

        <!-- Tab Content Panes -->
        <div class="tab-content" id="previewTabContent">
            
            <!-- 1. Day-by-Day Itinerary Tab -->
            <div class="tab-pane fade show active" id="itinerary-pane" role="tabpanel">
                <% for(let day of plan.dailyPlan) { %>
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-dark text-white p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0"><i class="fa-regular fa-calendar-check text-warning me-1"></i>Day <%= day.dayNumber %></h5>
                                <small class="text-light opacity-75 d-none d-md-inline">&bull; <%= day.morning.title %></small>
                            </div>
                            <% if(day.weather && day.weather.available) { %>
                                <span class="badge bg-light text-dark px-3 py-1 rounded-pill small fw-semibold">
                                    <%= day.weather.emoji || '🌤️' %> <%= day.weather.temperature %>&deg;C &bull; <%= day.weather.condition %>
                                </span>
                            <% } else { %>
                                <span class="badge bg-secondary bg-opacity-50 text-light px-2 py-1 rounded-pill small" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-cloud me-1"></i>Weather unavailable
                                </span>
                            <% } %>
                        </div>

                        <div class="card-body p-4">
                            <!-- Weather Advisory Note for the Day -->
                            <% if(day.weather && day.weather.available) { %>
                                <div class="p-3 mb-4 rounded-3 border-0 bg-light d-flex align-items-start gap-3">
                                    <span class="fs-4"><%= day.weather.emoji || '🌤️' %></span>
                                    <div class="w-100">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                            <strong class="text-dark"><%= day.weather.condition %> (<%= day.weather.tempMin %>&deg;C - <%= day.weather.tempMax %>&deg;C)</strong>
                                            <% if(day.weather.rainProbability > 0) { %>
                                                <span class="badge bg-info-subtle text-info-emphasis rounded-pill small"><i class="fa-solid fa-umbrella me-1"></i><%= day.weather.rainProbability %>% rain chance</span>
                                            <% } %>
                                        </div>
                                        <p class="text-secondary small mb-0 mt-1">
                                            <%= day.weather.suggestion || 'Weather conditions are suitable for planned activities.' %>
                                        </p>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Morning Slot (Travel or Sightseeing) -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="<%= day.dayNumber === 1 ? 'background-color: #0284c7; box-shadow: 0 0 0 2px #0284c7;' : '' %>"></div>
                                <% if(day.dayNumber === 1) { %>
                                    <span class="badge slot-badge-travel px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-car-side me-1"></i>JOURNEY &bull; <%= day.morning.time %></span>
                                <% } else { %>
                                    <span class="badge slot-badge-morning px-2 py-1 rounded-pill small fw-bold">MORNING &bull; <%= day.morning.time %></span>
                                <% } %>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.morning.title %></h6>
                                <p class="text-secondary small mb-1"><%= day.morning.description %></p>
                                <div class="small text-muted">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.morning.location %>
                                    <% if(day.morning.estimatedCost > 0) { %>
                                        &bull; <span class="fw-semibold text-dark">&#8377;<%= day.morning.estimatedCost.toLocaleString("en-IN") %> entry</span>
                                    <% } else if(day.dayNumber !== 1) { %>
                                        &bull; <span class="badge bg-success-subtle text-success">Free Entry</span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Lunch Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #f39c12; box-shadow: 0 0 0 2px #f39c12;"></div>
                                <span class="badge slot-badge-lunch px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-utensils me-1"></i>LUNCH &bull; <%= day.lunch.time %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.lunch.title %></h6>
                                <p class="text-secondary small mb-1">Cuisine: <strong><%= day.lunch.cuisine %></strong> &bull; Avg. &#8377;<%= day.lunch.estimatedCost.toLocaleString("en-IN") %>/person</p>
                                <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.lunch.location %></small>
                            </div>

                            <!-- Afternoon Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #8e44ad; box-shadow: 0 0 0 2px #8e44ad;"></div>
                                <span class="badge slot-badge-afternoon px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-person-hiking me-1"></i>AFTERNOON &bull; <%= day.afternoon.time %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.afternoon.title %></h6>
                                <p class="text-secondary small mb-1"><%= day.afternoon.description %></p>
                                <div class="small text-muted">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.afternoon.location %>
                                    <% if(day.afternoon.estimatedCost > 0) { %>
                                        &bull; <span class="fw-semibold text-dark">&#8377;<%= day.afternoon.estimatedCost.toLocaleString("en-IN") %> /person</span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Evening Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #e74c3c; box-shadow: 0 0 0 2px #e74c3c;"></div>
                                <span class="badge slot-badge-evening px-2 py-1 rounded-pill small fw-bold"><i class="fa-regular fa-moon me-1"></i>EVENING &bull; <%= day.evening.time %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.evening.title %></h6>
                                <p class="text-secondary small mb-1"><%= day.evening.description %></p>
                                <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.evening.location %></small>
                            </div>

                            <!-- Dinner Slot -->
                            <div class="timeline-card pb-4">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #34495e; box-shadow: 0 0 0 2px #34495e;"></div>
                                <span class="badge slot-badge-dinner px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-wine-glass me-1"></i>DINNER &bull; <%= day.dinner.time %></span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.dinner.title %></h6>
                                <p class="text-secondary small mb-1">Cuisine: <strong><%= day.dinner.cuisine %></strong> &bull; Avg. &#8377;<%= day.dinner.estimatedCost.toLocaleString("en-IN") %>/person</p>
                                <small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.dinner.location %></small>
                            </div>

                            <!-- Night Stay Slot -->
                            <div class="timeline-card">
                                <div class="position-absolute start-0 translate-middle-x timeline-dot mt-1" style="background-color: #27ae60; box-shadow: 0 0 0 2px #27ae60;"></div>
                                <span class="badge slot-badge-stay px-2 py-1 rounded-pill small fw-bold"><i class="fa-solid fa-bed me-1"></i>NIGHT STAY</span>
                                <h6 class="fw-bold text-dark mt-2 mb-1"><%= day.nightStay.title %></h6>
                                <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= day.nightStay.location %> &bull; &#8377;<%= day.nightStay.pricePerNight.toLocaleString("en-IN") %> /night</p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- 2. Interactive Map Tab -->
            <div class="tab-pane fade" id="map-pane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div>
                            <h5 class="fw-bold mb-0"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Trip Route & Points of Interest</h5>
                            <small class="text-muted">Origin 📍 <%= plan.fromLocation?.name?.split(',')[0] %> &rarr; Destination 📍 <%= plan.destinationName %> (<%= plan.travelDistanceKm %> km)</small>
                        </div>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                            <i class="fa-solid fa-route text-primary me-1"></i> <%= plan.transportMode %> Route
                        </span>
                    </div>
                    <div id="itinerary-map" class="rounded-4 border" style="height: 480px; width: 100%;"></div>
                </div>
            </div>

            <!-- 3. Weather Forecast Tab -->
            <div class="tab-pane fade" id="weather-pane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="fa-solid fa-cloud-sun text-warning me-2"></i>Destination Weather Forecast (<%= plan.destinationName %>)</h5>
                        <span class="badge bg-light text-secondary border">OpenWeatherMap Live Data</span>
                    </div>

                    <% if(plan.weather && plan.weather.available) { %>
                        <div class="row g-3 mb-4">
                            <% for(let day of plan.dailyPlan) { %>
                                <% if(day.weather && day.weather.available) { %>
                                    <div class="col-md-6 col-12">
                                        <div class="card h-100 border rounded-4 p-3 bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold mb-0">Day <%= day.dayNumber %></h6>
                                                <span class="fs-4"><%= day.weather.emoji || '🌤️' %></span>
                                            </div>
                                            <div class="d-flex align-items-baseline gap-2 mb-1">
                                                <h4 class="fw-bold mb-0 text-dark"><%= day.weather.temperature %>&deg;C</h4>
                                                <small class="text-muted">(Min: <%= day.weather.tempMin %>&deg;C / Max: <%= day.weather.tempMax %>&deg;C)</small>
                                            </div>
                                            <p class="text-secondary small mb-2"><%= day.weather.condition %></p>
                                            <div class="p-2 rounded-3 bg-white border small text-muted">
                                                <i class="fa-solid fa-circle-info text-primary me-1"></i><%= day.weather.suggestion %>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="fa-solid fa-cloud-sun-rain fa-3x text-muted mb-3"></i>
                            <h6 class="text-secondary">Weather information currently unavailable</h6>
                            <p class="text-muted small">Live OpenWeatherMap integration is active and will refresh when connection is available.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Budget Breakdown & Save Action -->
    <div class="col-lg-4 col-12">
        <div class="sticky-top" style="top: 6rem;">
            <!-- Budget Breakdown Card -->
            <div class="card cost-card border-0 shadow-lg p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold"><i class="fa-solid fa-calculator me-1"></i>Budget Summary</span>
                    <small class="opacity-75"><%= plan.numTravelers %> travelers &bull; <%= plan.durationDays %> days</small>
                </div>

                <div class="text-center my-3 pb-3 border-bottom border-light border-opacity-25">
                    <small class="text-uppercase tracking-wider opacity-75">Estimated Total Trip Cost</small>
                    <h1 class="display-5 fw-bold mb-0">&#8377;<%= plan.costBreakdown.grandTotal.toLocaleString("en-IN") %></h1>
                    <small class="opacity-75">(&#8377;<%= Math.round(plan.costBreakdown.grandTotal / plan.numTravelers).toLocaleString("en-IN") %> per person)</small>
                </div>

                <!-- Detailed Breakdown Items -->
                <div class="d-flex flex-column gap-2 text-white small mb-3">
                    <% const travelTransit = plan.costBreakdown.travelCost || 0; %>
                    <% const localTransit = (plan.costBreakdown.estimatedTransportation || 0) - travelTransit; %>
                    
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-plane-arrival text-info me-2"></i>Intercity <%= plan.transportMode || 'Travel' %> (<%= plan.travelDistanceKm %> km)</span>
                        <strong class="fs-6">&#8377;<%= travelTransit.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-taxi text-light me-2"></i>Estimated Local Transit</span>
                        <strong class="fs-6">&#8377;<%= Math.max(0, localTransit).toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-bed text-warning me-2"></i>Accommodation (<%= plan.durationDays > 1 ? plan.durationDays - 1 : 1 %> nights)</span>
                        <strong class="fs-6">&#8377;<%= plan.costBreakdown.stayTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-utensils text-warning me-2"></i>Meals & Dining</span>
                        <strong class="fs-6">&#8377;<%= plan.costBreakdown.foodTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-person-hiking text-success me-2"></i>Activities & Sports</span>
                        <strong class="fs-6">&#8377;<%= plan.costBreakdown.activitiesTotal.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fa-solid fa-ticket text-danger me-2"></i>Attraction Entry Fees</span>
                        <strong class="fs-6">&#8377;<%= plan.costBreakdown.entryFeesTotal.toLocaleString("en-IN") %></strong>
                    </div>
                </div>
            </div>

            <!-- Save Trip Action Box -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-2">Save This Itinerary</h5>
                <p class="text-muted small mb-3">Save this plan to your Wanderlust account so you can view, edit, download as PDF, or share it anytime.</p>

                <form action="/itinerary" method="POST">
                    <% 
                        const saveablePlan = {
                            title: plan.title,
                            fromLocation: plan.fromLocation,
                            destination: plan.destination,
                            destinationName: plan.destinationName,
                            transportMode: plan.transportMode,
                            travelDistanceKm: plan.travelDistanceKm,
                            travelDurationText: plan.travelDurationText,
                            travelCost: plan.travelCost,
                            routeGeometry: plan.routeGeometry,
                            startDate: plan.startDate,
                            endDate: plan.endDate,
                            durationDays: plan.durationDays,
                            numTravelers: plan.numTravelers,
                            budgetTier: plan.budgetTier,
                            interests: plan.interests,
                            selectedStay: plan.selectedStay,
                            dailyPlan: plan.dailyPlan,
                            costBreakdown: plan.costBreakdown
                        };
                    %>
                    <!-- Hidden Base64 Encoded JSON data -->
                    <input type="hidden" name="planData" value="<%= Buffer.from(JSON.stringify(saveablePlan)).toString('base64') %>">

                    <div class="mb-3">
                        <label for="customNotes" class="form-label small fw-semibold">Personal Trip Notes (Optional)</label>
                        <textarea name="customNotes" id="customNotes" rows="2" class="form-control form-control-sm rounded-3" placeholder="e.g. Packing list, rental bike contact, ticket bookings..."></textarea>
                    </div>

                    <% const user = (typeof currUser !== "undefined" && currUser) ? currUser : (typeof locals !== "undefined" && locals.currUser ? locals.currUser : null); %>
                    <% if(user) { %>
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill w-100 fw-bold shadow-sm" style="background-color: #fe424d; border-color: #fe424d;">
                            <i class="fa-regular fa-bookmark me-2"></i> Save Trip to My Account
                        </button>
                    <% } else { %>
                        <a href="/login" class="btn btn-outline-danger btn-lg rounded-pill w-100 fw-bold">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Login to Save Trip
                        </a>
                    <% } %>
                </form>

                <div class="mt-3 text-center">
                    <a href="/itinerary/new?destination=<%= plan.destinationName %>" class="btn btn-link btn-sm text-decoration-none text-muted">
                        <i class="fa-solid fa-rotate-left me-1"></i> Re-plan with different preferences
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const mapToken = "<%= mapToken || '' %>";
    const dailyPlan = <%- JSON.stringify(plan.dailyPlan || []) %>;
    const fromLocation = <%- JSON.stringify(plan.fromLocation || { name: 'Origin', coordinates: [76.7794, 30.7333] }) %>;
    const destCoords = <%- JSON.stringify(plan.destinationDetails?.geometry?.coordinates || [77.1892, 32.2432]) %>;
    const routeGeometry = <%- JSON.stringify(plan.routeGeometry || null) %>;

    if (mapToken && document.getElementById("itinerary-map")) {
        mapboxgl.accessToken = mapToken;
        
        let centerCoordinates = destCoords || [77.1892, 32.2432];

        const map = new mapboxgl.Map({
            container: "itinerary-map",
            style: "mapbox://styles/mapbox/streets-v12",
            center: centerCoordinates,
            zoom: 7
        });

        map.on("load", () => {
            const bounds = new mapboxgl.LngLatBounds();

            // 1. Origin Marker (Green Pin)
            if (fromLocation && fromLocation.coordinates && fromLocation.coordinates.length === 2) {
                const originMarker = new mapboxgl.Marker({ color: "#10b981" })
                    .setLngLat(fromLocation.coordinates)
                    .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(`<strong>📍 Origin (From)</strong><p class="mb-0 text-muted">${fromLocation.name}</p>`))
                    .addTo(map);
                bounds.extend(fromLocation.coordinates);
            }

            // 2. Destination Marker (Red Pin)
            if (destCoords && destCoords.length === 2) {
                const destMarker = new mapboxgl.Marker({ color: "#fe424d" })
                    .setLngLat(destCoords)
                    .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(`<strong>🏁 Destination (To)</strong><p class="mb-0 text-muted"><%= plan.destinationName %></p>`))
                    .addTo(map);
                bounds.extend(destCoords);
            }

            // 3. Add Route Line
            if (routeGeometry && routeGeometry.coordinates && routeGeometry.coordinates.length > 0) {
                map.addSource("route", {
                    type: "geojson",
                    data: {
                        type: "Feature",
                        properties: {},
                        geometry: routeGeometry
                    }
                });

                map.addLayer({
                    id: "route-line",
                    type: "line",
                    source: "route",
                    layout: {
                        "line-join": "round",
                        "line-cap": "round"
                    },
                    paint: {
                        "line-color": "#fe424d",
                        "line-width": 4,
                        "line-opacity": 0.85
                    }
                });

                routeGeometry.coordinates.forEach(coord => bounds.extend(coord));
            } else if (fromLocation?.coordinates && destCoords) {
                // Direct connecting line fallback
                map.addSource("route", {
                    type: "geojson",
                    data: {
                        type: "Feature",
                        properties: {},
                        geometry: {
                            type: "LineString",
                            coordinates: [fromLocation.coordinates, destCoords]
                        }
                    }
                });

                map.addLayer({
                    id: "route-line",
                    type: "line",
                    source: "route",
                    paint: {
                        "line-color": "#fe424d",
                        "line-width": 3,
                        "line-dasharray": [2, 2]
                    }
                });
            }

            // 4. Add markers for daily POIs
            dailyPlan.forEach((day) => {
                if (day.morning && day.morning.coordinates && day.morning.coordinates.length === 2 && day.dayNumber > 1) {
                    new mapboxgl.Marker({ color: "#f59e0b", scale: 0.85 })
                        .setLngLat(day.morning.coordinates)
                        .setPopup(new mapboxgl.Popup({ offset: 20 }).setHTML(`<strong>Day ${day.dayNumber} (Morning)</strong><p>${day.morning.title}</p>`))
                        .addTo(map);
                    bounds.extend(day.morning.coordinates);
                }
                if (day.afternoon && day.afternoon.coordinates && day.afternoon.coordinates.length === 2) {
                    new mapboxgl.Marker({ color: "#8e44ad", scale: 0.85 })
                        .setLngLat(day.afternoon.coordinates)
                        .setPopup(new mapboxgl.Popup({ offset: 20 }).setHTML(`<strong>Day ${day.dayNumber} (Afternoon)</strong><p>${day.afternoon.title}</p>`))
                        .addTo(map);
                    bounds.extend(day.afternoon.coordinates);
                }
            });

            // Fit map to show both Origin & Destination nicely
            if (!bounds.isEmpty()) {
                map.fitBounds(bounds, { padding: 60, maxZoom: 13 });
            }
        });

        map.addControl(new mapboxgl.NavigationControl());

        const mapTab = document.getElementById("map-tab");
        if (mapTab) {
            mapTab.addEventListener("shown.bs.tab", () => {
                map.resize();
            });
        }
    }
</script>
